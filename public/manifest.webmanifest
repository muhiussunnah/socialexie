{
  "id": "/",
  "name": "Socialexie",
  "short_name": "Socialexie",
  "description": "Plan, generate and publish across every network from one desk.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#0a0c10",
  "theme_color": "#0a0c10",
  "categories": ["business", "productivity", "social"],
  "icons": [
    {
      "src": "/icons/icon.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New post",
      "short_name": "Compose",
      "description": "Open the composer on a blank post.",
      "url": "/dashboard/composer",
      "icons": [
        {
          "src": "/icons/icon.svg",
          "sizes": "192x192",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "AI studio",
      "short_name": "Studio",
      "description": "Generate on-brand images for the queue.",
      "url": "/dashboard/studio",
      "icons": [
        {
          "src": "/icons/icon.svg",
          "sizes": "192x192",
          "type": "image/svg+xml"
        }
      ]
    }
  ]
}
