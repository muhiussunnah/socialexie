# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# Public site URL, used for metadata and OAuth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Bypasses row-level security; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of accounts allowed into the admin console.
ADMIN_EMAILS=itsinjamul@gmail.com

# ---------------------------------------------------------------------------
# AI providers. Any subset may be set; the router uses whatever is available.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
